rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function staff() {
      return request.auth != null && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.token.email.lower()))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.token.email.lower())).data.active == true;
    }
    match /worksheets/{wsId}/{file} {
      allow read: if staff();
      allow create: if staff() && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }
  }
}
